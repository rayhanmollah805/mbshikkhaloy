# Copy to backend.env and fill in. Never commit the real file.
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app_db
PORT=3001
FRONTEND_URL=https://your-domain.example
JWT_SECRET=generate-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=choose-a-strong-password
# YouTube live (Google Cloud OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI chat: either run the opencode bridge on the host (see bridge/) or use a paid key
CHATBOT_PROVIDER=opencode
CHATBOT_ALLOW_GUESTS=true
CHATBOT_OPENCODE_MODEL=opencode/glm-5.3-flash-free
CHATBOT_OPENCODE_URL=http://host.docker.internal:3199
CHATBOT_OPENCODE_TOKEN=same-value-as-BRIDGE_TOKEN
# CHATBOT_ANTHROPIC_API_KEY=
