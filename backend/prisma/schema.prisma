generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialType {
  PDF
  VIDEO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STUDENT)
  permissions  String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]
  attempts    Attempt[]
  teaching    BatchTeacher[]
  tickets     SupportTicket[]
}

model Batch {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPaid      Boolean  @default(false)
  fee         Int      @default(0)
  isActive    Boolean  @default(true)
  /// Marketing fields shown on the public course page.
  subtitle    String?
  highlights  String[] @default([])
  duration    String?
  createdAt   DateTime @default(now())

  teachers    BatchTeacher[]
  enrollments Enrollment[]
  liveClasses LiveClass[]
  routines    Routine[]
  notices     Notice[]
  materials   Material[]
  exams       Exam[]
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  batchId   String
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
  batch     Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([userId, batchId])
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String
  amount       Int
  method       String
  trxId        String
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model LiveClass {
  id       String   @id @default(cuid())
  batchId  String
  title    String
  url      String
  startsAt DateTime
  isLive   Boolean  @default(false)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Routine {
  id        String @id @default(cuid())
  batchId   String
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  batch     Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Notice {
  id        String   @id @default(cuid())
  batchId   String?
  title     String
  body      String
  createdAt DateTime @default(now())
  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Material {
  id        String       @id @default(cuid())
  batchId   String
  type      MaterialType
  title     String
  url       String
  createdAt DateTime     @default(now())
  batch     Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String     @id @default(cuid())
  batchId     String
  title       String
  durationMin Int
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  batch       Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    Attempt[]
}

model Question {
  id           String   @id @default(cuid())
  examId       String
  text         String
  options      String[]
  correctIndex Int
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Attempt {
  id          String   @id @default(cuid())
  examId      String
  userId      String
  answers     Json
  score       Int
  total       Int
  submittedAt DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([examId, userId])
}

/// A teacher is only allowed to touch batches they are assigned to here.
model BatchTeacher {
  batchId String
  userId  String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([batchId, userId])
}

/// Admin-editable site settings (payment numbers, support contact).
model Setting {
  key   String @id
  value String
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  USER
  STAFF
}

/// Human support chat. Guests prove ownership with `accessToken` (kept in their browser);
/// signed-in users are matched by `userId`.
model SupportTicket {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  contact     String?
  accessToken String
  status      TicketStatus     @default(OPEN)
  staffUnread Boolean          @default(true)
  userUnread  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  sender     MessageSender
  authorName String?
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
