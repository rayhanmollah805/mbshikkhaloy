# Copy to deploy/backend.env and fill in. Never commit the real file.
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app_db
PORT=3001
FRONTEND_URL=https://your-domain.example
JWT_SECRET=CHANGE_ME_long_random_hex
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=CHANGE_ME
# Chatbot: CHATBOT_PROVIDER=claude (needs CHATBOT_ANTHROPIC_API_KEY) or opencode (see README notes)
CHATBOT_PROVIDER=claude
CHATBOT_ALLOW_GUESTS=false
